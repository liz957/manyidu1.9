                    </tr>
                    
                    <tr>
                        <td>帮助文档或教程不足</td>
                        <td>1</td>
                        <td>3.2%</td>
                    </tr>
                    
                </tbody>
            </table>
            
        </div>
        
            </div>
            
            <div id="tab-device" class="tab-content">
                
        <p style="color: #8b7373; margin-bottom: 15px;">只显示不满意人数≥30的组合（已排除other）</p>
        <div class="dimension-selector" id="deviceSelector">
            <button class="dimension-btn active" onclick="filterDeviceReasons('F2')">F2</button><button class="dimension-btn " onclick="filterDeviceReasons('S1')">S1</button>
        </div>
        <div id="deviceReasonContent">
            
            <div class="version-filter" id="deviceVersionFilter">
                <button class="version-btn active" onclick="filterDeviceVersionReasons('F2', 'V1.2')">V1.2</button>
            </div>
            
            <table class="reason-table">
                <thead>
                    <tr>
                        <th>不满意理由</th>
                        <th>数量</th>
                        <th>占比</th>
                    </tr>
                </thead>
                <tbody id="deviceReasonTableBody">
                    
                    <tr>
                        <td>功能缺失或不好用</td>
